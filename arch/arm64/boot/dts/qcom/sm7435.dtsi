#include <dt-bindings/clock/qcom,sm7435-gcc.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interconnect/qcom,parrot.h>
#include <dt-bindings/soc/qcom,rpmh-rsc.h>

/ {
	compatible = "qcom,sm7435";
	interrupt-parent = <&intc>;

	#address-cells = <2>;
	#size-cells = <2>;

	chosen { };

	clocks {
		bi_tcxo: bi-tcxo {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <19200000>;
			clock-output-names = "bi_tcxo";
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
			clock-output-names = "sleep_clk";
		};

		uart3_boot_clk: uart3-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <7372800>;
			clock-output-names = "qup0-se3-boot";
		};

		usb_cfg_noc_boot_clk: usb-cfg-noc-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <100000000>;
		};

		usb_core_boot_clk: usb-core-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <133333333>;
		};

		usb_iface_boot_clk: usb-iface-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <100000000>;
		};

		usb_sleep_boot_clk: usb-sleep-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};

		usb_mock_utmi_boot_clk: usb-mock-utmi-boot-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <19200000>;
		};
	};

	clk_virt: interconnect-0 {
		compatible = "qcom,parrot-clk-virt";
		#interconnect-cells = <1>;
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	mc_virt: interconnect-1 {
		compatible = "qcom,parrot-mc-virt";
		#interconnect-cells = <1>;
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x0>;
		};

		cpu1: cpu@100 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x100>;
		};

		cpu2: cpu@200 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x200>;
		};

		cpu3: cpu@300 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x300>;
		};

		cpu4: cpu@400 {
			compatible = "arm,cortex-a78";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x400>;
		};

		cpu5: cpu@500 {
			compatible = "arm,cortex-a78";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x500>;
		};

		cpu6: cpu@600 {
			compatible = "arm,cortex-a78";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x600>;
		};

		cpu7: cpu@700 {
			compatible = "arm,cortex-a78";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0 0x700>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cluster_pd: power-domain-cluster {
			#power-domain-cells = <0>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 12 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
		clock-frequency = <19200000>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		memory@80000000 {
			reg = <0x0 0x80000000 0x0 0x600000>;
			no-map;
		};

		memory@80600000 {
			reg = <0x0 0x80600000 0x0 0x40000>;
			no-map;
		};

		memory@80640000 {
			reg = <0x0 0x80640000 0x0 0x1c0000>;
			no-map;
		};

		memory@80800000 {
			reg = <0x0 0x80800000 0x0 0x60000>;
			no-map;
		};

		aop_cmd_db_mem: memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x0 0x80860000 0x0 0x20000>;
			no-map;
		};

		memory@80880000 {
			reg = <0x0 0x80880000 0x0 0x20000>;
			no-map;
		};

		memory@808a0000 {
			reg = <0x0 0x808a0000 0x0 0x40000>;
			no-map;
		};

		memory@808e0000 {
			reg = <0x0 0x808e0000 0x0 0x4000>;
			no-map;
		};

		memory@808e4000 {
			reg = <0x0 0x808e4000 0x0 0x10000>;
			no-map;
		};

		memory@80900000 {
			reg = <0x0 0x80900000 0x0 0x200000>;
			no-map;
		};

		memory@80b00000 {
			reg = <0x0 0x80b00000 0x0 0x100000>;
			no-map;
		};

		memory@80c00000 {
			reg = <0x0 0x80c00000 0x0 0x1000>;
			no-map;
		};

		memory@82a00000 {
			reg = <0x0 0x82a00000 0x0 0xc00000>;
			no-map;
		};

		memory@84b00000 {
			reg = <0x0 0x84b00000 0x0 0x800000>;
			no-map;
		};

		memory@85300000 {
			reg = <0x0 0x85300000 0x0 0x1900000>;
			no-map;
		};

		memory@86c00000 {
			reg = <0x0 0x86c00000 0x0 0x700000>;
			no-map;
		};

		memory@87300000 {
			reg = <0x0 0x87300000 0x0 0x2100000>;
			no-map;
		};

		memory@89400000 {
			reg = <0x0 0x89400000 0x0 0xa00000>;
			no-map;
		};

		memory@89e00000 {
			reg = <0x0 0x89e00000 0x0 0x10000>;
			no-map;
		};

		memory@89e10000 {
			reg = <0x0 0x89e10000 0x0 0xa000>;
			no-map;
		};

		memory@89e1a000 {
			reg = <0x0 0x89e1a000 0x0 0x2000>;
			no-map;
		};

		memory@8bc00000 {
			reg = <0x0 0x8bc00000 0x0 0xe600000>;
			no-map;
		};

		memory@a6e00000 {
			reg = <0x0 0xa6e00000 0x0 0x40000>;
			no-map;
		};

		memory@a6f00000 {
			reg = <0x0 0xa6f00000 0x0 0x100000>;
			no-map;
		};

		memory@e0600000 {
			reg = <0x0 0xe0600000 0x0 0x400000>;
			no-map;
		};

		memory@e8800000 {
			reg = <0x0 0xe8800000 0x0 0x100000>;
			no-map;
		};

		memory@e8900000 {
			reg = <0x0 0xe8900000 0x0 0x680000>;
			no-map;
		};

		memory@e8f80000 {
			reg = <0x0 0xe8f80000 0x0 0x500000>;
			no-map;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		intc: interrupt-controller@17200000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#redistributor-regions = <1>;
			interrupt-controller;
			redistributor-stride = <0x0 0x20000>;
			reg = <0x0 0x17200000 0x0 0x10000>,
			      <0x0 0x17260000 0x0 0x100000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_LOW>;
		};

		gcc: clock-controller@100000 {
			compatible = "qcom,sm7435-gcc";
			reg = <0x0 0x00100000 0x0 0x1f4200>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
			clocks = <&bi_tcxo>,
				 <&sleep_clk>,
				 <0>,
				 <0>,
				 <0>,
				 <0>,
				 <0>;
			clock-names = "bi_tcxo", "sleep_clk",
				      "pcie_0_pipe_clk",
				      "ufs_phy_rx_symbol_0_clk",
				      "ufs_phy_rx_symbol_1_clk",
				      "ufs_phy_tx_symbol_0_clk",
				      "usb3_phy_wrapper_gcc_usb30_pipe_clk";
		};

		apps_rsc: rsc@17a00000 {
			compatible = "qcom,rpmh-rsc";
			reg = <0x0 0x17a00000 0x0 0x10000>,
			      <0x0 0x17a10000 0x0 0x10000>,
			      <0x0 0x17a20000 0x0 0x10000>;
			reg-names = "drv-0", "drv-1", "drv-2";
			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&cluster_pd>;
			qcom,tcs-offset = <0xd00>;
			qcom,drv-id = <2>;
			qcom,tcs-config = <ACTIVE_TCS 3>, <SLEEP_TCS 2>,
					  <WAKE_TCS 2>, <CONTROL_TCS 0>;
			label = "apps_rsc";

			apps_bcm_voter: bcm-voter {
				compatible = "qcom,bcm-voter";
			};
		};

		cnoc2: interconnect@1500000 {
			compatible = "qcom,parrot-cnoc2";
			reg = <0x0 0x01500000 0x0 0x1000>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		cnoc3: interconnect@1502000 {
			compatible = "qcom,parrot-cnoc3";
			reg = <0x0 0x01502000 0x0 0x1000>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		system_noc: interconnect@1680000 {
			compatible = "qcom,parrot-system-noc";
			reg = <0x0 0x01680000 0x0 0x1e200>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		pcie_anoc: interconnect@16c0000 {
			compatible = "qcom,parrot-pcie-anoc";
			reg = <0x0 0x016c0000 0x0 0xe280>;
			#interconnect-cells = <1>;
			clocks = <&gcc GCC_AGGRE_NOC_PCIE_0_AXI_CLK>,
				 <&gcc GCC_CFG_NOC_PCIE_ANOC_AHB_CLK>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		aggre1_noc: interconnect@16e0000 {
			compatible = "qcom,parrot-aggre1-noc";
			reg = <0x0 0x016e0000 0x0 0x1c080>;
			#interconnect-cells = <1>;
			clocks = <&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		aggre2_noc: interconnect@1700000 {
			compatible = "qcom,parrot-aggre2-noc";
			reg = <0x0 0x01700000 0x0 0x31080>;
			#interconnect-cells = <1>;
			clocks = <&gcc GCC_SDCC2_AHB_CLK>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		mmss_noc: interconnect@1740000 {
			compatible = "qcom,parrot-mmss-noc";
			reg = <0x0 0x01740000 0x0 0x1f080>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		gem_noc: interconnect@19100000 {
			compatible = "qcom,parrot-gem-noc";
			reg = <0x0 0x19100000 0x0 0xbb800>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		nsp_noc: interconnect@320c0000 {
			compatible = "qcom,parrot-nsp-noc";
			reg = <0x0 0x320c0000 0x0 0x10000>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		lpass_ag_noc: interconnect@3c40000 {
			compatible = "qcom,parrot-lpass-ag-noc";
			reg = <0x0 0x03c40000 0x0 0x17200>;
			#interconnect-cells = <1>;
			qcom,bcm-voters = <&apps_bcm_voter>;
		};

		tlmm: pinctrl@f000000 {
			compatible = "qcom,sm7435-tlmm";
			reg = <0x0 0x0f000000 0x0 0x1000000>;
			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-reserved-ranges = <0 4>, <18 4>, <38 1>;
			gpio-ranges = <&tlmm 0 0 142>;
			wakeup-parent = <&pdc>;
		};

		uart3: serial@98c000 {
			compatible = "qcom,geni-debug-uart";
			reg = <0x0 0x0098c000 0x0 0x4000>;
			clocks = <&uart3_boot_clk>;
			clock-names = "se";
			interrupts = <GIC_SPI 604 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		pdc: interrupt-controller@b220000 {
			compatible = "qcom,sm7435-pdc", "qcom,pdc";
			reg = <0x0 0x0b220000 0x0 0x30000>,
			      <0x0 0x174000f0 0x0 0x64>;
			qcom,pdc-ranges = <0 480 94>, <94 609 31>,
					  <125 63 1>, <126 716 12>;
			#interrupt-cells = <2>;
			interrupt-parent = <&intc>;
			interrupt-controller;
		};

		usb_hsphy: phy@88e3000 {
			compatible = "qcom,sm8150-usb-hs-phy", "qcom,usb-snps-hs-7nm-phy";
			reg = <0x0 0x088e3000 0x0 0x11c>;
			#phy-cells = <0>;

			clocks = <&gcc GCC_EUSB3_0_CLKREF_EN>;
			clock-names = "ref";
			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;

			vdda-pll-supply = <&usb_hs_core>;
			vdda18-supply = <&usb_hs_1v8>;
			vdda33-supply = <&usb_hs_3v3>;
			status = "okay";
		};

		usb_1: usb@a600000 {
			compatible = "qcom,sm7435-dwc3", "qcom,snps-dwc3";
			reg = <0x0 0x0a600000 0x0 0xfc100>;

			/*
			 * Use the GCC provider for all DWC3 clocks.  Rates remain
			 * inherited from the bootloader for this first consumer switch;
			 * assigning shared RCG rates is a separate hardware-ownership
			 * step.
			 */
			clocks = <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
				 <&gcc GCC_USB30_PRIM_MASTER_CLK>,
				 <&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>,
				 <&gcc GCC_USB30_PRIM_SLEEP_CLK>,
				 <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>;
			clock-names = "cfg_noc", "core", "iface", "sleep",
				      "mock_utmi";
			assigned-clocks = <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK_SRC>,
					  <&gcc GCC_USB30_PRIM_MASTER_CLK_SRC>;
			assigned-clock-rates = <19200000>, <133333333>;
			resets = <&gcc GCC_USB30_PRIM_BCR>;
			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
			phys = <&usb_hsphy>;
			phy-names = "usb2-phy";
			interconnects = <&aggre1_noc MASTER_USB3_0
					 &mc_virt SLAVE_EBI1>,
					<&gem_noc MASTER_APPSS_PROC
					 &cnoc2 SLAVE_USB3_0>;
			interconnect-names = "usb-ddr", "apps-usb";

			interrupts-extended = <&intc GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>,
					      <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
					      <&pdc 14 IRQ_TYPE_EDGE_RISING>,
					      <&pdc 15 IRQ_TYPE_EDGE_RISING>,
					      <&pdc 17 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dwc_usb3", "pwr_event", "dp_hs_phy_irq",
					  "dm_hs_phy_irq", "ss_phy_irq";

			/*
			 * No dma-coherent: it only holds when this DWC3 runs
			 * behind the APPS SMMU, which is how downstream uses
			 * it.  Without an SM7435 SMMU driver the controller
			 * does plain non-coherent DMA, and claiming coherence
			 * makes the driver read stale zeroes out of its event
			 * ring.
			 */
			qcom,select-utmi-as-pipe-clk;
			snps,dis_u2_susphy_quirk;
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			dr_mode = "peripheral";
			maximum-speed = "high-speed";

			status = "disabled";
		};
	};
};
