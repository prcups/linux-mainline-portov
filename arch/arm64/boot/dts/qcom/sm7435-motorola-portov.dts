/dts-v1/;

#include "sm7435.dtsi"

/ {
	model = "Motorola moto g67 power 5G";
	compatible = "motorola,portov", "qcom,sm7435";

	aliases {
		serial0 = &uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon keep_bootcon console=ttyMSM0,115200n8 ignore_loglevel";
	};
};

&reserved_memory {
	ramoops@ae000000 {
		compatible = "ramoops";
		reg = <0x0 0xae000000 0x0 0x60000>;
		record-size = <0x20000>;
		console-size = <0x40000>;
		no-map;
	};
};

&uart3 {
	status = "okay";
};
