/dts-v1/;

#include "sm7435.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Motorola moto g67 power 5G";
	compatible = "motorola,portov", "qcom,sm7435";

	aliases {
		serial0 = &uart3;
	};

	chosen {
		bootargs = "console=ttyGS0,115200n8 ignore_loglevel printk.time=1";
		#address-cells = <2>;
		#size-cells = <2>;

		/*
		 * The firmware reserves a continuous-splash framebuffer and the
		 * panel keeps scanning out of it, so it can double as a console.
		 * Same values as diagnostics/portov-console-fixup.dtsi, but
		 * expressed here because this tree is used directly rather than
		 * as the base for that fixup.  Diagnostic-only: not upstreamable.
		 */
		framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xb8000000 0x00 0x9e3400>;
			width = <1080>;
			height = <2400>;
			stride = <4320>;
			format = "x8r8g8b8";
		};
	};

	usb_hs_core: regulator-usb-hs-core {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_core";
		regulator-min-microvolt = <880000>;
		regulator-max-microvolt = <880000>;
		regulator-always-on;
	};

	usb_hs_1v8: regulator-usb-hs-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	usb_hs_3v3: regulator-usb-hs-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	panel_vddio: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	panel_lab: regulator-panel-lab {
		compatible = "regulator-fixed";
		regulator-name = "panel_lab";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
		regulator-always-on;
		regulator-boot-on;
	};

	panel_ibb: regulator-panel-ibb {
		compatible = "regulator-fixed";
		regulator-name = "panel_ibb";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dsi_vdda: regulator-dsi-vdda {
		compatible = "regulator-fixed";
		regulator-name = "dsi_vdda";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dsi_vdds: regulator-dsi-vdds {
		compatible = "regulator-fixed";
		regulator-name = "dsi_vdds";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x68e00000>,
		      <0x0 0xf0900000 0x0 0x0f700000>,
		      <0x8 0x00000000 0x0 0x3f8fe000>,
		      <0x8 0x40000000 0x0 0x7a300000>,
		      <0x8 0xba500000 0x0 0x01e00000>,
		      <0x8 0xc0000000 0x0 0x40000000>,
		      <0x9 0x00000000 0x1 0x80000000>;
	};
};

&reserved_memory {
	/*
	 * Match the official portov continuous-splash carveout. Keep it in
	 * the linear map: portovfb writes through phys_to_virt(), but these
	 * pages must never be handed to the general-purpose allocator.
	 */
	splash_mem: framebuffer@b8000000 {
		reg = <0x0 0xb8000000 0x0 0x02b00000>;
	};

	smem_mem: smem@80900000 {
		reg = <0x0 0x80900000 0x0 0x200000>;
		no-map;
	};

	ramoops@ae000000 {
		compatible = "ramoops";
		reg = <0x0 0xae000000 0x0 0x60000>;
		record-size = <0x20000>;
		console-size = <0x40000>;
		no-map;
	};
};

/*
 * uart3 stays disabled: it is described as a bare `qcom,geni-debug-uart`
 * without a `geni-se-qup` wrapper parent, and mainline's geni-se glue needs
 * that parent - geni_se_clks_on() dereferences se->wrapper, which is NULL
 * here, so enabling it oopses the kernel (data abort at
 * geni_se_clks_on+0x1c).  The console paths used by the diagnostic payloads
 * are portovfb and the USB ACM gadget, so nothing needs this node; a real
 * UART needs the QUP wrapper description plus the GCC SE clocks.
 */
&uart3 {
	status = "disabled";
};

&usb_1 {
	status = "okay";
};

&dispcc {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&dsi_vdda>;
	status = "okay";

	panel@0 {
		compatible = "boe,icnl9922c";
		reg = <0>;
		reset-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
		vddio-supply = <&panel_vddio>;
		lab-supply = <&panel_lab>;
		ibb-supply = <&panel_ibb>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&dsi_vdds>;
	status = "okay";
};
